{
  "name": "@ciderjs/gasnuki",
  "version": "0.2.4",
  "description": "Type definitions and utilities for Google Apps Script client-side API",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "gasnuki": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "import": "./dist/promise.mjs",
      "require": "./dist/promise.cjs"
    }
  },
  "scripts": {
    "generate": "jiti .bin/generate.ts",
    "dev": "pnpm run generate && jiti src/cli.ts -p playground/react -s src/server",
    "start": "node dist/cli.mjs -p playground/react -s src/server",
    "check": "biome check --write",
    "build": "unbuild",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "update-coverage-badge": "jiti scripts/update-coverage-badge.ts README.md README.ja.md",
    "test:coverage:update": "pnpm test:coverage && pnpm update-coverage-badge",
    "prepare": "pnpm run generate && pnpm run check && pnpm run test:coverage:update && pnpm run build",
    "pg:react": "pnpm -C playground/react",
    "pg:vue": "pnpm -C playground/vue3"
  },
  "keywords": ["google-apps-script", "typescript", "@google/clasp"],
  "author": "ciderjs/luth",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:luthpg/gasnuki.git"
  },
  "bugs": {
    "url": "https://github.com/luthpg/gasnuki/issues"
  },
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@inquirer/prompts": "^7.5.3",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "consola": "^3.4.2",
    "jiti": "^2.4.2",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "3.2.1",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vitest": "^3.2.1"
  }
}
