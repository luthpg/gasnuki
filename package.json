{
  "name": "@ciderjs/gasnuki",
  "version": "0.5.7",
  "description": "Type definitions and utilities for Google Apps Script client-side API",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "gasnuki": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "import": "./dist/promise.mjs",
      "require": "./dist/promise.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.mjs",
      "require": "./dist/json.cjs"
    }
  },
  "scripts": {
    "generate": "jiti .bin/generate.ts",
    "dev": "pnpm run generate && jiti src/cli.ts -p playground/react -s src/server",
    "start": "node dist/cli.mjs -p playground/react -s src/server",
    "check": "biome check --write",
    "build": "unbuild",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "update-coverage-badge": "jiti scripts/update-coverage-badge.ts README.md README.ja.md",
    "test:coverage:update": "pnpm test:coverage && pnpm update-coverage-badge",
    "prepublish": "pnpm run generate && pnpm run check && pnpm run test:coverage:update && pnpm run build",
    "pg:react": "pnpm -C playground/react",
    "pg:react-vite": "pnpm -C playground/react-with-vite-plugin",
    "pg:vue": "pnpm -C playground/vue3"
  },
  "keywords": [
    "google-apps-script",
    "typescript",
    "@google/clasp"
  ],
  "author": "ciderjs/luth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luthpg/gasnuki"
  },
  "bugs": {
    "url": "https://github.com/luthpg/gasnuki/issues"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "jiti": "^2.6.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "typescript": "^6.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.0.8",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "vite": "^7 || ^8"
  },
  "overrides": {
    "axios": "1.14.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.14.0"
    }
  }
}
